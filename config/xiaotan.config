# ============================================================
# Xiaotan OpenWrt 25.12.5 - 精简种子配置
# ============================================================
# 说明：
# 1. 这不是 make menuconfig 生成的几千行完整 .config。
# 2. build-local.sh 会把本文件复制为 OpenWrt/.config，随后执行
#    make defconfig 自动补齐默认项和依赖，所以这里只保留“我关心的配置”。
# 3. 想改固件规格，优先修改这个文件；想增删插件，看 scripts/select-packages.sh。
# ============================================================

# ---------- 目标平台：x86_64 Generic ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------- 固件格式：UEFI + SquashFS ----------
# 使用 SquashFS：基础系统只读，配置和后装软件放在 overlay。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# 生成 GRUB/UEFI 启动镜像。
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_CONSOLE=y

# 输出 .img.gz，最后使用 combined-efi.img.gz 刷 Hyper-V/虚拟机。
CONFIG_TARGET_IMAGES_GZIP=y

# 内核分区 32 MiB 足够 x86_64 OpenWrt 使用。
CONFIG_TARGET_KERNEL_PARTSIZE=32

# RootFS 分区大小（MiB）。
# 之前是 2048 MiB；现在改为 1024 MiB。
# OpenClash/AdGuardHome 会额外占 overlay，512 MiB 偏紧，所以这里保留 1 GiB 余量。
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ---------- 本地增量编译 ----------
# 开启 ccache。后续重复编译时可以复用 GCC 编译结果。
CONFIG_CCACHE=y

# ---------- LuCI 基础 ----------
# 完整 LuCI + HTTPS。
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# 简体中文。
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# OpenWrt 25.12 使用 apk，对应 LuCI 新软件包管理器。
CONFIG_PACKAGE_luci-app-package-manager=y
