# ============================================================
# Xiaotan OpenWrt v4.5.1 - 人类可读版本表
# ============================================================
# 原则：
#   1. OpenWrt 使用官方稳定 Release。
#   2. 第三方优先使用正式 Release / Tag。
#   3. 没有适合 25.12 的现代 Release 时，才使用 dated snapshot；
#      snapshot 的底层源码锁定放在 scripts/source-locks.sh，不需要日常维护 SHA。
#   4. 第三方源码统一使用 tarball cache，不执行 git clone --mirror。

BUILD_VERSION=v4.5.1

# ---------- OpenWrt ----------
OPENWRT_VERSION=v25.12.5

# ---------- 正式 Release / Tag ----------
ARGON_VERSION=v2.4.6
ARGON_CONFIG_VERSION=v0.9
EASYTIER_VERSION=v2.6.4
LUCKY_VERSION=v2.27.2
OPENCLASH_VERSION=v0.47.156

# rufengsuixing 的 LuCI 插件没有现代 Release；使用 master 最后提交的固定快照。
ADGUARDHOME_LUCI_VERSION=1.8-11-snapshot-2020-01-12

# ---------- 无合适现代 Release：使用已验证快照 ----------
# DiskMan 当前源码包版本为 0.2.13，但上游 GitHub Release 停留在旧版。
DISKMAN_VERSION=0.2.13-snapshot-2026-05-19

# Lean luci-app-cifs-mount 当前包版本 1-r7，没有独立 Release。
CIFS_MOUNT_VERSION=1-r7-snapshot

# rtp2httpd Core 使用正式上游 3.14.2；OpenWrt/LuCI 包装层使用固定快照。
RTP2HTTPD_VERSION=3.14.2

# openwrt-sonic-fullcone 当前没有 GitHub Release/Tag；
# 使用 2026-08-15 已包含 OpenWrt 25.12/libnftnl autoreconf 修复的快照。
SONIC_FULLCONE_VERSION=2026.08.15-snapshot
