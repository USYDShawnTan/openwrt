#!/bin/sh /etc/rc.common

START=100
STOP=9
USE_PROCD=1

PROXY_PORT=9092
MIHOMO_HOST=127.0.0.1
MIHOMO_PORT=9091

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/socat \
        TCP-LISTEN:${PROXY_PORT},reuseaddr,fork,bind=0.0.0.0 \
        TCP:${MIHOMO_HOST}:${MIHOMO_PORT}
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    logger -t netflow-zashboard "Mihomo API bridge listening on ${PROXY_PORT} -> ${MIHOMO_HOST}:${MIHOMO_PORT}"
}
